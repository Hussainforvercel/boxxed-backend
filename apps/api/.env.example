# Copy to apps/api/.env for local development. Never commit real secrets.
# Full per-environment table: docs/12-deployment.md#environment-variables

NODE_ENV=development
APP_ENV=local
# 3100 locally (3000 is commonly taken by other dev servers); 3000 behind the proxy in staging/prod.
PORT=3100

# Local docker compose (root .env.example). Staging/prod: Neon pooled URL (?sslmode=require).
DATABASE_URL=postgresql://boxxed:boxxed_local_only@localhost:5433/boxxed
# Neon direct (non-pooled) URL — used only by `prisma migrate` (prisma.config.ts).
DIRECT_URL=postgresql://boxxed:boxxed_local_only@localhost:5433/boxxed
# Throwaway DB for `prisma migrate dev` / drift check (create once: createdb boxxed_shadow).
SHADOW_DATABASE_URL=postgresql://boxxed:boxxed_local_only@localhost:5433/boxxed_shadow

REDIS_URL=redis://localhost:6379

LOG_LEVEL=debug
# Required outside local. Comma-separated, never "*" in production.
CORS_ORIGINS=*
TRUST_PROXY_HOPS=0
GRAPHQL_MAX_COMPLEXITY=1000
GRAPHQL_MAX_DEPTH=8

# ── Auth tokens (docs/06 §5). Secrets: ≥ 32 bytes, access ≠ refresh.
# Generate real ones with: openssl rand -base64 48
JWT_ACCESS_SECRET=local-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=local-only-refresh-secret-change-me-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=boxxed-api
JWT_AUDIENCE=boxxed-app

# ── OTP. Codes are stored only as HMAC-SHA256(OTP_HMAC_SECRET, code).
OTP_HMAC_SECRET=local-only-otp-hmac-secret-change-me-00000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_LOCK_SECONDS=900
# Staging E2E only: comma-separated emails/E.164 phones that get OTP_TEST_CODE and no delivery.
# Must be unset in production (boot fails).
OTP_TEST_DESTINATIONS=
OTP_TEST_CODE=

# ── SMS. `console` prints codes to the terminal only when APP_ENV=local; refused in production.
SMS_PROVIDER=console
# Global SMS-per-UTC-day cap. Optional locally (default 1000), required in staging/prod.
SMS_DAILY_CAP=

# ── Google Sign-In: the audiences accepted for ID tokens (docs/12 §Google Sign-In setup).
GOOGLE_WEB_CLIENT_ID=local-placeholder-web.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=local-placeholder-ios.apps.googleusercontent.com

# ── Mail. Local: the Mailpit container from docker-compose (UI http://localhost:8025).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@boxxed.local

# ── Legal documents shown on D-4/D-8 (Q-G1: placeholders until final URLs exist).
LEGAL_TERMS_VERSION=2026-09-01
LEGAL_TERMS_URL=https://boxxed.example/terms
LEGAL_PRIVACY_VERSION=2026-09-01
LEGAL_PRIVACY_URL=https://boxxed.example/privacy

# Optional
SENTRY_DSN=
