# ─────────────────────────────────────────────────────────────
# BOXXED BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and apps/api/.env for local development.
# ─────────────────────────────────────────────────────────────

# Server Environment
NODE_ENV=development
APP_ENV=local
PORT=3100

# PostgreSQL Database (Docker Compose: port 5433 maps to container 5432)
POSTGRES_VERSION=17
POSTGRES_USER=boxxed
POSTGRES_PASSWORD=boxxed_local_only
POSTGRES_DB=boxxed
POSTGRES_PORT=5433

DATABASE_URL=postgresql://boxxed:boxxed_local_only@localhost:5433/boxxed
DIRECT_URL=postgresql://boxxed:boxxed_local_only@localhost:5433/boxxed
SHADOW_DATABASE_URL=postgresql://boxxed:boxxed_local_only@localhost:5433/boxxed_shadow

# Redis In-Memory Store & Throttler
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Logging & Operational Parameters
LOG_LEVEL=debug
CORS_ORIGINS=*
TRUST_PROXY_HOPS=0
GRAPHQL_MAX_COMPLEXITY=1000
GRAPHQL_MAX_DEPTH=8

# JWT Authentication Secrets (Access & Refresh Tokens)
JWT_SECRET=local-only-access-secret-change-me-0000000000
JWT_ACCESS_SECRET=local-only-access-secret-change-me-0000000000
JWT_REFRESH_SECRET=local-only-refresh-secret-change-me-000000000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=boxxed-api
JWT_AUDIENCE=boxxed-app

# Customer Phone OTP & SMS Delivery (console prints OTP to stdout in local mode)
OTP_HMAC_SECRET=local-only-otp-hmac-secret-change-me-00000000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=30
OTP_LOCK_SECONDS=900
OTP_TEST_DESTINATIONS=+923000000001
OTP_TEST_CODE=424242
SMS_PROVIDER=console

# Mailpit (Local Mail Catcher: SMTP 1025, Web UI http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@boxxed.local

# Legal & Compliance Documents
LEGAL_TERMS_VERSION=2026-09-01
LEGAL_TERMS_URL=https://boxxed.example/terms
LEGAL_PRIVACY_VERSION=2026-09-01
LEGAL_PRIVACY_URL=https://boxxed.example/privacy

# Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@boxxed.pk
SEED_ADMIN_PASSWORD=SuperAdmin123!@#
